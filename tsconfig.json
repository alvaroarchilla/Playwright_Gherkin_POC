{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "types": ["node", "@cucumber/cucumber"]
    },

    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "allure-results", "allure-report"]
}