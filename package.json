    "allure-commandline": "^2.43.0",
    "allure-cucumberjs": "^2.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1"
